{
  "title": "isotropic_damage",
  "include": ["../standard_small_strain.json"],
  "notes": "The tangent check skips steps whose strain state lies exactly on the damage surface (the first threshold step and the load reversals): the response has a kink there and a central difference straddles both branches.",
  "parameters": {"K": 166666.67, "G": 76923.08, "kappa_0": 0.002, "beta": 300.0, "alpha": 0.9, "K_pow": 50.0, "m_pow": 1.2, "K_sat": 0.95, "m_sat": 400.0, "amplitude": 0.01},
  "derived": {"E": "9 * K * G / (3 * K + G)"},
  "model": {"materials": [
    {"type": "external_strain_source", "name": "strain"},
    {"type": "von_mises_state_function", "name": "state", "strain_source": "strain"},
    {"type": "strain_threshold_yield", "name": "yield", "state_source": "state", "kappa_critical": "$kappa_0"},
    {"type": "exponential_damage_law", "name": "law", "yield_source": "yield", "kappa_0": "$kappa_0", "beta": "$beta"},
    {"type": "peerlings_damage_law", "name": "peerlings", "yield_source": "yield", "kappa_0": "$kappa_0", "alpha": "$alpha", "beta": "$beta"},
    {"type": "power_damage_law", "name": "power", "yield_source": "yield", "K": "$K_pow", "m": "$m_pow", "kappa_0": "$kappa_0"},
    {"type": "saturation_damage_law", "name": "saturation", "yield_source": "yield", "K": "$K_sat", "m": "$m_sat", "kappa_0": "$kappa_0"},
    {"type": "linear_elasticity", "name": "elastic", "strain_producer_name": "strain", "K": "$K", "G": "$G"},
    {"type": "isotropic_damage", "name": "damaged", "elastic_source": "elastic", "damage_source": "law", "state_source": "state", "yield_source": "yield"}]},
  "point": {"strain_source": "strain", "stress_source": "damaged", "stress_property": "damaged_stress", "tangent_property": "damaged_tangent"},
  "record": {"kappa": "yield::kappa", "eq": "state::equivalent_strain", "d": "law::damage", "d_peerlings": "peerlings::damage", "d_power": "power::damage", "d_saturation": "saturation::damage",
             "sig_elastic": "elastic::stress", "yielding": "yield::is_yielding"},
  "checks": [
    {"name": "tangent vs central differences", "cases": "*", "value": "tangent_error", "tolerance": "$tangent_tolerance",
     "where": "np.isfinite(tangent_error) & (yielding == 0) & (abs(eq - kappa) > 1e-9)"},
    {"name": "σ = (1 − d) σ_elastic", "cases": "*", "value": "stress_11", "expected": "(1 - d) * sig_elastic_11", "tolerance": 1e-10, "relative": true, "plot": {"x": "strain_11"}},
    {"name": "κ never decreases", "cases": "*", "value": "np.minimum(np.diff(kappa, prepend=0), 0)", "tolerance": 0},
    {"name": "no damage below the threshold", "cases": "*", "value": "np.where(kappa <= kappa_0, d, 0)", "tolerance": 0},
    {"name": "every law is monotone in κ", "case": "uniaxial_stress", "value": "np.minimum(np.diff(d_peerlings, prepend=0), 0) + np.minimum(np.diff(d_power, prepend=0), 0) + np.minimum(np.diff(d_saturation, prepend=0), 0)", "where": "np.diff(kappa, prepend=0) > 0", "tolerance": 1e-15},
    {"name": "Peerlings: d = 1 − κ0/κ (1 − α + α e^{β(κ0 − κ)})", "case": "uniaxial_stress", "value": "d_peerlings", "expected": "np.where(kappa > kappa_0, 1 - kappa_0 / np.maximum(kappa, 1e-30) * (1 - alpha + alpha * np.exp(beta * (kappa_0 - kappa))), 0)", "tolerance": 1e-12},
    {"name": "saturation: d = K (1 − e^{−m(κ − κ0)})", "case": "uniaxial_stress", "value": "d_saturation", "expected": "np.where(kappa > kappa_0, K_sat * (1 - np.exp(-m_sat * (kappa - kappa_0))), 0)", "tolerance": 1e-12}
  ],
  "figures": [
    {"title": "Damage laws along the uniaxial-stress path", "columns": 2, "panels": [
      {"title": "damage over κ", "case": "uniaxial_stress", "x": "kappa", "xlabel": "κ", "ylabel": "d",
       "y": [{"expr": "d", "label": "exponential (the point)"}, {"expr": "d_peerlings", "label": "Peerlings"}, {"expr": "d_power", "label": "power"}, {"expr": "d_saturation", "label": "saturation"}]},
      {"title": "stress with and without damage", "case": "uniaxial_stress", "x": "strain_11", "y": [{"expr": "stress_11", "label": "damaged"}, {"expr": "sig_elastic_11", "label": "elastic"}], "ylabel": "σ₁₁"}]}
  ]
}
