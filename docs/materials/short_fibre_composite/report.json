{
  "title": "short_fibre_composite",
  "include": ["../standard_small_strain.json"],
  "parameters": {"Km": 3333.33, "Gm": 1153.85, "Kf": 166666.67, "Gf": 76923.08, "c": 0.2, "aspect_ratio": 15.0, "precision": 23},
  "model": {"materials": [
    {"type": "external_strain_source", "name": "strain"},
    {"type": "linear_elasticity", "name": "matrix", "strain_producer_name": "strain", "K": "$Km", "G": "$Gm"},
    {"type": "linear_elasticity", "name": "fibre", "strain_producer_name": "strain", "K": "$Kf", "G": "$Gf"},
    {"type": "inclusion", "name": "spheroid", "material": "fibre", "shape": "spheroid", "volume_fraction": "$c", "aspect_ratio": "$aspect_ratio", "direction": [1, 0, 0]},
    {"type": "mean_field_composite", "name": "ud", "matrix": "matrix", "inclusions": ["spheroid"], "kernel": "mori_tanaka", "strain_source": "strain"},
    {"type": "short_fibre_composite", "name": "aligned", "matrix": "matrix", "fibre": "fibre", "volume_fraction": "$c", "aspect_ratio": "$aspect_ratio",
     "orientation": [1, 0, 0, 0, 0, 0], "precision": "$precision", "strain_source": "strain"},
    {"type": "short_fibre_composite", "name": "injection", "matrix": "matrix", "fibre": "fibre", "volume_fraction": "$c", "aspect_ratio": "$aspect_ratio",
     "orientation": [0.7, 0.25, 0.05, 0, 0, 0], "precision": "$precision", "strain_source": "strain"},
    {"type": "short_fibre_composite", "name": "random", "matrix": "matrix", "fibre": "fibre", "volume_fraction": "$c", "aspect_ratio": "$aspect_ratio",
     "orientation": [0.3333333333333333, 0.3333333333333333, 0.3333333333333334, 0, 0, 0], "precision": "$precision", "strain_source": "strain"},
    {"type": "short_fibre_composite", "name": "random_stiffness", "matrix": "matrix", "fibre": "fibre", "volume_fraction": "$c", "aspect_ratio": "$aspect_ratio",
     "orientation": [0.3333333333333333, 0.3333333333333333, 0.3333333333333334, 0, 0, 0], "precision": "$precision", "averaging": "stiffness", "strain_source": "strain"}]},
  "point": {"strain_source": "strain", "stress_source": "injection"},
  "record": {"sig_ud": "ud::stress", "sig_aligned": "aligned::stress", "sig_random": "random::stress", "sig_random_stiffness": "random_stiffness::stress",
             "C1111_random": "random::tangent[1,1,1,1]", "C2222_random": "random::tangent[2,2,2,2]", "C1122_random": "random::tangent[1,1,2,2]", "C1212_random": "random::tangent[1,2,1,2]",
             "A_m": "injection::concentration_matrix[1,1,1,1]", "A_f": "injection::concentration_fibre[1,1,1,1]"},
  "checks": [
    {"name": "aligned fibres equal the unidirectional Mori-Tanaka spheroid", "cases": "*", "value": "np.sqrt((sig_aligned_11 - sig_ud_11)**2 + (sig_aligned_22 - sig_ud_22)**2 + (sig_aligned_12 - sig_ud_12)**2)", "tolerance": 1e-9, "relative": true, "expected": "np.sqrt(sig_ud_11**2 + sig_ud_22**2 + sig_ud_12**2)"},
    {"name": "random orientation is isotropic: C1111 = C2222, C1212 = (C1111 − C1122)/2", "case": "uniaxial_strain", "value": "np.maximum(abs(C1111_random - C2222_random), abs(C1212_random - (C1111_random - C1122_random) / 2)) / C1111_random", "tolerance": 1e-6},
    {"name": "injection moulded: stiffer along the flow than across", "case": "uniaxial_strain", "value": "np.maximum(stress_22 - stress_11, 0)", "where": "strain_11 > 0", "tolerance": 0},
    {"name": "ordering along x1: aligned ≥ injection ≥ random", "case": "uniaxial_strain", "value": "np.maximum(stress_11 - sig_aligned_11, 0) + np.maximum(sig_random_11 - stress_11, 0)", "where": "strain_11 > 0", "tolerance": 1e-9},
    {"name": "concentrations average to one", "cases": "*", "value": "(1 - c) * A_m + c * A_f", "expected": 1, "tolerance": 1e-10}
  ],
  "figures": [
    {"title": "Orientation states under uniaxial strain", "columns": 2, "panels": [
      {"title": "σ₁₁ along the flow direction", "case": "uniaxial_strain", "x": "strain_11", "ylabel": "σ₁₁",
       "y": [{"expr": "sig_aligned_11", "label": "aligned"}, {"expr": "stress_11", "label": "injection (0.7, 0.25, 0.05)"}, {"expr": "sig_random_11", "label": "random"}, {"expr": "sig_random_stiffness_11", "label": "random, stiffness averaging"}]},
      {"title": "σ₂₂ across the flow direction", "case": "uniaxial_strain", "x": "strain_11", "ylabel": "σ₂₂",
       "y": [{"expr": "sig_aligned_22", "label": "aligned"}, {"expr": "stress_22", "label": "injection"}, {"expr": "sig_random_22", "label": "random"}]}]}
  ]
}
