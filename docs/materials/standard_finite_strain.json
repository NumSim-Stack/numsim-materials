{
  "parameters": {"steps": 50, "stretch": 0.3, "shear": 0.5, "tangent_tolerance": 1e-6, "tangent_every": 5, "fd_step": 1e-6},
  "cases": [
    {"name": "uniaxial_stretch", "direction": [1, 0, 0, 0, 0, 0], "path": [0, 1, -0.6], "scale": "$stretch", "steps": "$steps", "tangent_every": "$tangent_every", "fd_step": "$fd_step"},
    {"name": "uniaxial_stress", "control": "uniaxial_stress", "direction": [1, 0, 0, 0, 0, 0], "path": [0, 1, -0.6], "scale": "$stretch", "steps": "$steps", "tangent_every": "$tangent_every", "fd_step": "$fd_step"},
    {"name": "simple_shear", "direction": [0, 0, 0, 1, 0, 0, 0, 0, 0], "path": [0, 1, -1], "scale": "$shear", "steps": "$steps", "tangent_every": "$tangent_every", "fd_step": "$fd_step"},
    {"name": "equibiaxial_stretch", "direction": [1, 1, 0, 0, 0, 0], "path": [0, 1, -0.5], "scale": "$stretch", "steps": "$steps", "tangent_every": "$tangent_every", "fd_step": "$fd_step"},
    {"name": "volumetric", "direction": [1, 1, 1, 0, 0, 0], "path": [0, 1, -0.5], "scale": "$stretch", "steps": "$steps", "tangent_every": "$tangent_every", "fd_step": "$fd_step"}
  ],
  "figures": [
    {"title": "First Piola-Kirchhoff stress for prescribed deformation", "panels": [
      {"title": "uniaxial stretch", "case": "uniaxial_stretch", "x": "F_11", "y": ["P_11", "P_22"], "xlabel": "F₁₁"},
      {"title": "simple shear", "case": "simple_shear", "x": "F_12", "y": ["P_12", "P_21"], "xlabel": "F₁₂ = γ"},
      {"title": "equibiaxial stretch", "case": "equibiaxial_stretch", "x": "F_11", "y": ["P_11", "P_33"], "xlabel": "F₁₁"},
      {"title": "volumetric", "case": "volumetric", "x": "J", "y": ["p"], "ylabel": "Cauchy pressure p"}]},
    {"title": "Uniaxial stress (1D) and its Newton iterations",
     "text": "F₁₁ is prescribed; the other eight components of F are solved for zero P with dP/dF.",
     "panels": [
      {"title": "Cauchy stress", "case": "uniaxial_stress", "x": "F_11", "y": ["stress_11"], "xlabel": "λ = F₁₁"},
      {"title": "lateral stretch", "case": "uniaxial_stress", "x": "F_11", "y": ["F_22", "F_33"], "xlabel": "λ = F₁₁"},
      {"title": "residual per step (colour: step)", "case": "uniaxial_stress", "kind": "residuals"},
      {"title": "iterations per step", "case": "uniaxial_stress", "kind": "iterations"}]},
    {"title": "Simple shear: normal stresses", "columns": 1,
     "text": "The Cauchy stress of simple shear at finite strain has normal components that small strain does not.",
     "panels": [{"case": "simple_shear", "x": "F_12", "y": ["stress_11", "stress_22", "stress_12"], "xlabel": "γ"}]},
    {"title": "Tangent check", "columns": 1,
     "text": "Relative difference between dP/dF and central differences of P (step fd_step), every tangent_every-th step.",
     "panels": [{"cases": "*", "x": "step", "y": [{"expr": "np.maximum(tangent_error, 1e-17)", "label": "‖A − A_fd‖ / ‖A‖"}], "logy": true}]}
  ],
  "checks": [
    {"name": "tangent vs central differences", "cases": "*", "value": "tangent_error", "where": "np.isfinite(tangent_error)", "tolerance": "$tangent_tolerance"},
    {"name": "P Fᵀ is symmetric (angular momentum)", "cases": "*",
     "value": "abs(P_11 * F_21 + P_12 * F_22 + P_13 * F_23 - (P_21 * F_11 + P_22 * F_12 + P_23 * F_13)) / np.maximum(np.sqrt(P_11**2 + P_22**2 + P_33**2 + P_12**2 + P_21**2), 1e-30)", "tolerance": 1e-9},
    {"name": "uniaxial stress is uniaxial", "case": "uniaxial_stress", "value": "np.sqrt(P_22**2 + P_33**2 + P_12**2 + P_21**2 + P_13**2 + P_31**2 + P_23**2 + P_32**2) / np.maximum(abs(P_11), 1e-30)", "tolerance": 1e-8}
  ]
}
