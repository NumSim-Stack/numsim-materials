{
  "title": "mean_field_tangent",
  "include": ["../standard_small_strain.json"],
  "parameters": {"Km": 3333.33, "Gm": 1153.85, "Ki": 166666.67, "Gi": 76923.08, "c": 0.3, "cm": 0.7, "nu_m": 0.3448},
  "derived": {
    "K_MT": "Km + c * (Ki - Km) / (1 + (1 - c) * (Ki - Km) / (Km + 4 * Gm / 3))",
    "G_star": "Gm * (9 * Km + 8 * Gm) / (6 * (Km + 2 * Gm))",
    "G_MT": "Gm + c * (Gi - Gm) / (1 + (1 - c) * (Gi - Gm) / (Gm + G_star))",
    "E_MT": "9 * K_MT * G_MT / (3 * K_MT + G_MT)",
    "nu_MT": "(3 * K_MT - 2 * G_MT) / (2 * (3 * K_MT + G_MT))",
    "K_dil": "Km + c * (Ki - Km) / (1 + (Ki - Km) / (Km + 4 * Gm / 3))"
  },
  "model": {"materials": [
    {"type": "external_strain_source", "name": "strain"},
    {"type": "constant_scalar", "name": "Km_", "value": "$Km"}, {"type": "constant_scalar", "name": "Gm_", "value": "$Gm"},
    {"type": "constant_scalar", "name": "Ki_", "value": "$Ki"}, {"type": "constant_scalar", "name": "Gi_", "value": "$Gi"},
    {"type": "isotropic_tangent", "name": "C_matrix", "K_source": "Km_", "G_source": "Gm_"},
    {"type": "isotropic_tangent", "name": "C_filler", "K_source": "Ki_", "G_source": "Gi_"},
    {"type": "isotropic_moduli", "name": "moduli", "tangent_source": "C_matrix"},
    {"type": "eshelby_sphere", "name": "sphere", "nu_source": "moduli", "nu_property": "poisson_ratio"},
    {"type": "eshelby_cylinder", "name": "cylinder", "nu_source": "moduli", "nu_property": "poisson_ratio", "direction": [1, 0, 0]},
    {"type": "constant_scalar", "name": "c", "value": "$c"},
    {"type": "constant_scalar", "name": "cm", "value": "$cm"},
    {"type": "phase", "name": "matrix", "tangent_source": "C_matrix", "fraction_source": "cm", "eshelby_source": "sphere"},
    {"type": "phase", "name": "spheres", "tangent_source": "C_filler", "fraction_source": "c", "eshelby_source": "sphere"},
    {"type": "phase", "name": "fibres", "tangent_source": "C_filler", "fraction_source": "c", "eshelby_source": "cylinder"},
    {"type": "mean_field_tangent", "name": "mt", "matrix": "matrix", "phases": ["spheres"], "kernel": "mori_tanaka"},
    {"type": "mean_field_tangent", "name": "dilute", "matrix": "matrix", "phases": ["spheres"], "kernel": "dilute"},
    {"type": "mean_field_tangent", "name": "ud", "matrix": "matrix", "phases": ["fibres"], "kernel": "mori_tanaka"},
    {"type": "isotropic_moduli", "name": "moduli_eff", "tangent_source": "scs", "tolerance": 0},
    {"type": "eshelby_sphere", "name": "sphere_eff", "nu_source": "moduli_eff", "nu_property": "poisson_ratio", "nu_edge": "local", "nu_initial": "$nu_m"},
    {"type": "phase", "name": "matrix_sc", "tangent_source": "C_matrix", "fraction_source": "cm", "eshelby_source": "sphere_eff"},
    {"type": "phase", "name": "spheres_sc", "tangent_source": "C_filler", "fraction_source": "c", "eshelby_source": "sphere_eff"},
    {"type": "mean_field_tangent", "name": "scs", "matrix": "matrix_sc", "phases": ["spheres_sc"], "kernel": "self_consistent"},
    {"type": "linear_stress", "name": "mt_stress", "tangent_source": "mt", "strain_source": "strain"},
    {"type": "linear_stress", "name": "dilute_stress", "tangent_source": "dilute", "strain_source": "strain"},
    {"type": "linear_stress", "name": "scs_stress", "tangent_source": "scs", "strain_source": "strain"},
    {"type": "linear_stress", "name": "ud_stress", "tangent_source": "ud", "strain_source": "strain"}]},
  "point": {"strain_source": "strain", "stress_source": "mt_stress", "tangent_source": "mt", "residual": "scs::residual", "tolerance": 1e-10, "max_passes": 200},
  "record": {"sig_dilute": "dilute_stress::stress", "sig_scs": "scs_stress::stress", "sig_ud": "ud_stress::stress",
             "A_m": "mt::concentration_matrix[1,1,1,1]", "A_i": "mt::concentration_spheres[1,1,1,1]", "res_scs": "scs::residual"},
  "checks": [
    {"name": "Mori-Tanaka spheres: σ11 = E_MT ε11 (uniaxial stress)", "case": "uniaxial_stress", "value": "stress_11", "expected": "E_MT * strain_11", "tolerance": 1e-9, "relative": true, "plot": {"x": "strain_11"}},
    {"name": "Mori-Tanaka spheres: ε22 = −ν_MT ε11", "case": "uniaxial_stress", "value": "strain_22", "expected": "-nu_MT * strain_11", "tolerance": 1e-9, "relative": true},
    {"name": "Mori-Tanaka spheres: p = 3 K_MT ε (hydrostatic)", "case": "hydrostatic_strain", "value": "p", "expected": "3 * K_MT * strain_11", "tolerance": 1e-9, "relative": true},
    {"name": "dilute spheres: p = 3 K_dil ε (hydrostatic)", "case": "hydrostatic_strain", "value": "(sig_dilute_11 + sig_dilute_22 + sig_dilute_33) / 3", "expected": "3 * K_dil * strain_11", "tolerance": 1e-9, "relative": true},
    {"name": "self-consistent is stiffer than Mori-Tanaka (stiff inclusions)", "case": "hydrostatic_strain", "value": "np.maximum(abs(stress_11) - abs(sig_scs_11), 0)", "tolerance": 1e-9},
    {"name": "Mori-Tanaka concentrations average to one", "cases": "*", "value": "(1 - c) * A_m + c * A_i", "expected": 1, "tolerance": 1e-10},
    {"name": "aligned fibres are stiffer along than across", "case": "uniaxial_strain", "value": "np.maximum(sig_ud_22 - sig_ud_11, 0)", "where": "strain_11 > 0", "tolerance": 0}
  ],
  "figures": [
    {"title": "Kernels and shapes under uniaxial strain", "columns": 1, "panels": [
      {"case": "uniaxial_strain", "x": "strain_11", "ylabel": "σ₁₁",
       "y": [{"expr": "sig_dilute_11", "label": "dilute spheres"}, {"expr": "stress_11", "label": "Mori-Tanaka spheres"},
             {"expr": "sig_scs_11", "label": "self-consistent spheres"}, {"expr": "sig_ud_11", "label": "Mori-Tanaka aligned fibres"}]}]}
  ]
}
