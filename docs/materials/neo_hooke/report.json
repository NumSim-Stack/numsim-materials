    {"name": "uniaxial stress at small stretch: σ11 ≈ E (λ − 1)", "case": "uniaxial_stress", "where": "abs(F_11 - 1) < 2e-2", "value": "stress_11", "expected": "E * (F_11 - 1)", "tolerance": 3e-2, "relative": true}
