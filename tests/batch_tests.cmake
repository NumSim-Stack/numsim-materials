# cmake -DOUT=<file> -DSOURCES=<a|b|...> -P batch_tests.cmake
# Writes one translation unit holding several test files, each in its own namespace.
# Every #include of the files is hoisted above the namespaces, so the inner ones are no-ops.
string(REPLACE "|" ";" SOURCES "${SOURCES}")
set(_includes)
set(_bodies)
set(_k 0)
foreach(_src IN LISTS SOURCES)
  file(STRINGS "${_src}" _lines REGEX "^[ \t]*#[ \t]*include")
  list(APPEND _includes ${_lines})
  string(APPEND _bodies "namespace numsim_test_batch_${_k} {\n#include \"${_src}\"\n}\n")
  math(EXPR _k "${_k} + 1")
endforeach()
list(REMOVE_DUPLICATES _includes)
list(JOIN _includes "\n" _includes)
set(_content "// Generated by tests/batch_tests.cmake.\n${_includes}\n\n${_bodies}")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
  if(_old STREQUAL _content)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${_content}")
